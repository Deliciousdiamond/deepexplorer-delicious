<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <FrameLayout
        android:id="@+id/home_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/home_bg_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />


        <View
            android:id="@+id/home_bg_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/home_scrim" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/browser_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="58dp"
        android:background="@color/bg"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:elevation="0dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/url_pill"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/url_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_globe"
                android:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/url_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/reload_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_icon_ripple"
            android:contentDescription="@string/reload"
            android:padding="9dp"
            android:src="@drawable/ic_reload"
            android:tint="@color/on_surface_variant" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="48dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/primary"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/find_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_glass_panel"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/find_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/find_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:padding="0dp"
            android:singleLine="true"
            android:textColor="@color/on_bg"
            android:textColorHint="@color/on_surface_variant"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/find_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/on_surface_variant"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/find_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_ripple"
            android:contentDescription="@string/find_prev"
            android:padding="9dp"
            android:src="@drawable/ic_chevron_up"
            android:tint="@color/on_surface_variant" />

        <ImageView
            android:id="@+id/find_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_ripple"
            android:contentDescription="@string/find_next"
            android:padding="9dp"
            android:src="@drawable/ic_chevron_down"
            android:tint="@color/on_surface_variant" />

        <ImageView
            android:id="@+id/find_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_ripple"
            android:contentDescription="@string/close"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            android:tint="@color/on_surface_variant" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/connection_banner"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="52dp"
        android:layout_marginEnd="12dp"
        android:elevation="9dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/connection_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_wifi_off"
            android:tint="#FFFFFFFF" />

        <TextView
            android:id="@+id/connection_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/download_banner"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="52dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_download_banner"
        android:clickable="true"
        android:elevation="10dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/download_banner_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_download"
            android:tint="#FFFFFFFF" />

        <TextView
            android:id="@+id/download_banner_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/download_start"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <WebView
        android:id="@+id/ai_web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="84dp"
        android:layout_marginBottom="58dp"
        android:background="@android:color/transparent"
        android:overScrollMode="never"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="58dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:id="@+id/home_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/home_app_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0"
                android:text="@string/app_name"
                android:textColor="@color/on_bg"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/home_tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="3dp"
                android:letterSpacing="0"
                android:text="@string/home_tagline"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/search_box"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_search"
            android:elevation="0dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:id="@+id/engine_picker"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_ripple"
                android:clickable="true"
                android:contentDescription="@string/search_engine"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/engine_badge"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="G"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />

                <ImageView
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginStart="1dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_drop_down"
                    android:tint="@color/on_surface_variant" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="10dp"
                android:background="@color/outline" />

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical|start"
                android:hint="@string/search_hint"
                android:imeOptions="actionGo"
                android:inputType="text"
                android:maxLines="1"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="@color/on_bg"
                android:textColorHint="@color/on_surface_variant"
                android:textSize="15sp" />

            <FrameLayout
                android:id="@+id/ai_button"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_icon_ripple"
                android:clickable="true"
                android:contentDescription="@string/ai_mode_on"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ai_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ai"
                    android:tint="@color/on_surface_variant" />
            </FrameLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/home_widgets_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/home_widgets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_glass_nav"
        android:elevation="0dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/nav_back"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item"
                android:clickable="true"
                android:contentDescription="@string/back"
                android:focusable="true">

                <ImageView
                    android:id="@+id/icon_back"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_back"
                    android:tint="@color/on_surface_variant" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/nav_forward"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item"
                android:clickable="true"
                android:contentDescription="@string/forward"
                android:focusable="true">

                <ImageView
                    android:id="@+id/icon_forward"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_forward"
                    android:tint="@color/on_surface_variant" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item"
                android:clickable="true"
                android:contentDescription="@string/home"
                android:focusable="true">

                <ImageView
                    android:id="@+id/icon_home"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_home"
                    android:tint="@color/on_surface_variant" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/nav_tabs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item"
                android:clickable="true"
                android:contentDescription="@string/tabs"
                android:focusable="true">

                <ImageView
                    android:id="@+id/icon_tabs"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_tabs"
                    android:tint="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/tab_badge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="18dp"
                    android:background="@drawable/bg_badge"
                    android:gravity="center"
                    android:textColor="@color/on_error"
                    android:textSize="9sp"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/nav_menu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item"
                android:clickable="true"
                android:contentDescription="@string/menu"
                android:focusable="true">

                <ImageView
                    android:id="@+id/icon_menu"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_more_vert"
                    android:tint="@color/on_surface_variant" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/ai_fab"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="72dp"
        android:background="@drawable/bg_ai_fab"
        android:clickable="true"
        android:contentDescription="@string/ai_chat_entry"
        android:elevation="4dp"
        android:focusable="true"
        android:padding="15dp"
        android:src="@drawable/ic_ai"
        android:tint="@color/on_primary"
        android:visibility="gone" />


    <include
        android:id="@+id/settings_page"
        layout="@layout/page_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
    <include
        android:id="@+id/page_overlay"
        layout="@layout/page_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
